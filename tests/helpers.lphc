@mode(host.native)

# Shared helpers for the stat tests: string comparison that works in native
# test binaries, and files with chosen sizes, modes and links. Not a test
# file itself: the tests import it.
#
# Runtime: host.native, test support. Never built on its own: `make test`
# puts tests/ on LOUPPATH, so `loup-bootstrap test --native` compiles it
# into each test binary that imports it. Not part of build/stat. The files
# are made in the test binary's working directory, a fresh temporary
# directory for each test file.

from debug.assert import (expect);

extern native "c" func chmod(path: string, mode: uint32): int32;
extern native "c" func link(existing: string, created: string): int32;
extern native "c" func symlink(target: string, created: string): int32;
extern native "c" func mkfifo(path: string, mode: uint32): int32;

# expectEq on two strings fails in native tests even when they are equal
# (Loup 1.26.0), so string results are compared with ==.
pub func expect_text(actual: string, expected: string, context: string): void {
    expect(actual == expected, i"{$ context $}: expected '{$ expected $}', got '{$ actual $}'");
}

# A file of exactly `size` bytes with permission bits `mode`.
pub func make_file(path: string, size: int, mode: int): void {
    writeText(path, "z".repeat(size));
    expect(chmod(path, mode as uint32) == 0i32, "chmod " + path);
}

pub func set_mode(path: string, mode: int): void {
    expect(chmod(path, mode as uint32) == 0i32, "chmod " + path);
}

pub func make_hard_link(existing: string, created: string): void {
    expect(link(existing, created) == 0i32, "link " + created);
}

pub func make_symlink(target: string, created: string): void {
    expect(symlink(target, created) == 0i32, "symlink " + created);
}

pub func make_fifo(path: string): void {
    expect(mkfifo(path, 0o644u32) == 0i32, "mkfifo " + path);
}
