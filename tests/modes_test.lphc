@mode(host.native)

# Unit tests for stat's readings of raw numbers (format/modes.lphc): file
# types, permission strings, device numbers, file-system type names and
# octal/hex text.
#
# Runtime: host.native, run by the test runner: `make test` runs
# `loup-bootstrap test --native`, which compiles each `func test_*()` here
# into its own native binary and runs it. Not part of build/stat.

from debug.assert import (expect, expectEq);
from helpers import (expect_text);
from format.modes import (file_type_name, mode_string, major_of, minor_of, fs_type_name,
    in_base, is_link_mode, is_device_mode);

func test_file_types(): void {
    expect_text(file_type_name(0o100644, 3), "regular file", "regular");
    expect_text(file_type_name(0o100644, 0), "regular empty file", "empty");
    expect_text(file_type_name(0o040755, 4096), "directory", "directory");
    expect_text(file_type_name(0o120777, 6), "symbolic link", "link");
    expect_text(file_type_name(0o020666, 0), "character special file", "char device");
    expect_text(file_type_name(0o060660, 0), "block special file", "block device");
    expect_text(file_type_name(0o010644, 0), "fifo", "fifo");
    expect_text(file_type_name(0o140755, 0), "socket", "socket");
    expect(is_link_mode(0o120777) and !is_link_mode(0o100644), "is_link_mode");
    expect(is_device_mode(0o020666) and !is_device_mode(0o040755), "is_device_mode");
}

func test_mode_strings(): void {
    expect_text(mode_string(0o100644), "-rw-r--r--", "644");
    expect_text(mode_string(0o040755), "drwxr-xr-x", "755 directory");
    expect_text(mode_string(0o041777), "drwxrwxrwt", "sticky /tmp");
    expect_text(mode_string(0o041776), "drwxrwxrwT", "sticky without x");
    expect_text(mode_string(0o104755), "-rwsr-xr-x", "setuid");
    expect_text(mode_string(0o102644), "-rw-r-Sr--", "setgid without x");
    expect_text(mode_string(0o120777), "lrwxrwxrwx", "link");
    expect_text(mode_string(0o020666), "crw-rw-rw-", "char device");
    expect_text(mode_string(0o010600), "prw-------", "fifo");
}

func test_device_numbers(): void {
    # 259,2 is 0x10302 in glibc's encoding; 1,3 is /dev/null.
    expectEq(major_of(66306u64) as int, 259, "major");
    expectEq(minor_of(66306u64) as int, 2, "minor");
    expectEq(major_of(259u64) as int, 1, "major of 1,3");
    expectEq(minor_of(259u64) as int, 3, "minor of 1,3");
    # A large minor spills into the high bits: makedev(8, 1048575).
    let big: uint64 = (0xfffffu64 & 0xffu64) | ((0xfffffu64 & 0xfffffff00u64) << 12u64) | (8u64 << 8u64);
    expectEq(minor_of(big) as int, 1048575, "20-bit minor");
    expectEq(major_of(big) as int, 8, "and its major");
}

func test_bases(): void {
    expect_text(in_base(0u64, 16u64), "0", "zero");
    expect_text(in_base(33188u64, 16u64), "81a4", "mode in hex");
    expect_text(in_base(420u64, 8u64), "644", "octal");
    expect_text(in_base(18446744073709551615u64, 16u64), "ffffffffffffffff", "all 64 bits");
}

func test_file_system_types(): void {
    expect_text(fs_type_name(0xEF53), "ext2/ext3", "ext4 shows as ext2/ext3, like GNU");
    expect_text(fs_type_name(0x01021994), "tmpfs", "tmpfs");
    expect_text(fs_type_name(0x9123683E), "btrfs", "btrfs");
    expect_text(fs_type_name(0x58465342), "xfs", "xfs");
    expect_text(fs_type_name(0x1234), "UNKNOWN (0x1234)", "unknown magic");
}
