@mode(host.native)

# Application identity and exit statuses of stat. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.native. Constants only, compiled into the native binary
# build/stat by `make build` (Stage0, `loup-bootstrap build --target
# native`) and into each test binary that imports them.

pub const APP_NAME: string = "stat";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Display file or file system status.";

# GNU stat exits 1 for any trouble: a usage error or a file it could not
# examine.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
